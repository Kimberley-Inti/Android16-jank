+TEST_P(DisplayModeSwitchingTest, timerModeRequestDoesNotWaitForMainThreadStateLock) {
+    mFlinger.mutableMainThreadId() = std::this_thread::get_id();
+
+    sp<MessageHandler> pendingRequest;
+    EXPECT_CALL(*mFlinger.scheduler(), postMessage(_))
+            .WillOnce([&](sp<MessageHandler>&& handler) { pendingRequest = std::move(handler); });
+
+    std::promise<void> returned;
+    auto completion = returned.get_future();
+    std::future_status status;
+    std::thread timer;
+    {
+        // Reproduce the lock held by commit/finalizeDisplayModeChange. A timer must
+        // finish while this lock is held, otherwise stopIdleTimer cannot join it.
+        Mutex::Autolock lock(mFlinger.mutableStateLock());
+        timer = std::thread([&] {
+            mFlinger.requestDisplayModes({});
+            returned.set_value();
+        });
+        status = completion.wait_for(std::chrono::seconds(2));
+        // Release the lock before joining even on failure, so the old synchronous
+        // implementation fails the assertion instead of hanging the test process.
+    }
+    timer.join();
+    EXPECT_EQ(status, std::future_status::ready);
+    ASSERT_NE(pendingRequest, nullptr);
+    pendingRequest->handleMessage(Message());
+}
+
+TEST_P(DisplayModeSwitchingTest, mainThreadModeRequestDoesNotRelockStateLock) {
+    mFlinger.mutableMainThreadId() = std::this_thread::get_id();
+    EXPECT_CALL(*mFlinger.scheduler(), postMessage(_)).Times(0);
+    Mutex::Autolock lock(mFlinger.mutableStateLock());
+    mFlinger.requestDisplayModes({});
+}
