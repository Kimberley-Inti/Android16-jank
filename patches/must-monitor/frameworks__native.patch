+void FrameTimeline::collectMustJank(const DisplayFrame& frame, nsecs_t monoBootOffset) {
+    if (mMustSession.empty()) return;
+    constexpr int32_t deadlineMask = JankType::AppDeadlineMissed |
+            JankType::SurfaceFlingerCpuDeadlineMissed |
+            JankType::SurfaceFlingerGpuDeadlineMissed;
+    const nsecs_t now = systemTime(SYSTEM_TIME_BOOTTIME);
+    for (const auto& surface : frame.getSurfaceFrames()) {
+        ++mMustTotalFrames;
+        const auto classification = surface->getMustJankType();
+        if (!classification) continue;
+        ++mMustValidFrames;
+        const int32_t type = *classification;
+        if (type == JankType::None || type == JankType::Unknown) continue;
+        ++mMustLabeledFrames;
+        if (type & deadlineMask) ++mMustJankyFrames;
+        const auto predicted = surface->getPredictions();
+        const auto actual = surface->getActuals();
+        const nsecs_t expected = predicted.presentTime > 0
+                ? predicted.presentTime + monoBootOffset : 0;
+        const nsecs_t presented = actual.presentTime > 0
+                ? actual.presentTime + monoBootOffset : 0;
+        const nsecs_t timestamp = presented > 0 ? presented : now;
+        // Layer names can contain whitespace; quote and escape for key=value parsing.
+        std::string layer = surface->getLayerName();
+        for (char& ch : layer) {
+            if (ch == '"' || ch == '\\' || ch == '\n' || ch == '\r') ch = '_';
+        }
+        __android_log_print(ANDROID_LOG_INFO, "MUST_JANK",
+                "session=%s event_id=%" PRIu64 " ts_ns=%" PRId64
+                " pid=%d uid=%u layer_id=%d layer=\"%s\""
+                " surface_frame_token=%" PRId64 " display_frame_token=%" PRId64
+                " input_event_id=%d expected_present_ns=%" PRId64
+                " actual_present_ns=%" PRId64 " delay_ns=%" PRId64
+                " jank_type=%d deadline_jank=%d severity=%d refresh_rate=%.2f",
+                mMustSession.c_str(), ++mMustEventId, timestamp,
+                surface->getOwnerPid(), surface->getOwnerUid(), surface->getLayerId(),
+                layer.c_str(), surface->getToken(), frame.getToken(), surface->getInputEventId(),
+                expected, presented, expected && presented ? presented - expected : 0,
+                type, (type & deadlineMask) != 0,
+                static_cast<int>(surface->getJankSeverityType().value_or(JankSeverityType::Unknown)),
+                frame.getRefreshRate());
+    }
+    if (now - mMustLastStatsNs >= 5'000'000'000LL) {
+        mMustLastStatsNs = now;
+        __android_log_print(ANDROID_LOG_INFO, "MUST_JANK_STATS",
+                "session=%s ts_ns=%" PRId64 " total_frames=%" PRIu64
+                " valid_frames=%" PRIu64
+                " janky_frames=%" PRIu64 " labeled_frames=%" PRIu64
+                " deadline_source=FrameTimeline",
+                mMustSession.c_str(), now, mMustTotalFrames, mMustValidFrames, mMustJankyFrames,
+                mMustLabeledFrames);
+    }
+}
